# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=19003

# Required only when the production data directory has no users yet.
# Use a unique high-entropy value; it is never printed by the server.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Require TOTP (Google Authenticator, 1Password, Authy, etc.) before session creation.
MFA_REQUIRED=true
MFA_ISSUER="Vibes Dashboard"
# Generate once with: openssl rand -base64 32
# Back this up. Changing it invalidates every enrolled authenticator secret.
MFA_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional network allowlist. Empty means no IP restriction.
# Accepts comma-separated exact IPv4/IPv6 addresses and CIDRs.
# ACCESS_ALLOWED_IPS=203.0.113.10,198.51.100.0/24,2001:db8::/32
ACCESS_ALLOWED_IPS=

# Trust forwarded client IPs only from these reverse-proxy peers.
# For nginx on this host, loopback is normally sufficient.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Agent runtime
USE_VIBES=false
ALLOW_LOCAL_PROXY=false
